{
  "name": "researchmindmap",
  "private": true,
  "version": "0.1.0",
  "description": "Search scholarly databases and turn the results into a research mind map",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "concurrently -k -n web,api -c cyan,magenta \"vite\" \"npm:dev:server\"",
    "dev:web": "vite",
    "dev:server": "tsx watch server/index.ts --api-only",
    "start": "tsx server/index.ts",
    "app": "npm run build && npm start",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "preview": "vite preview",
    "build:exe": "node scripts/build-exe.mjs",
    "smoke:exe": "node scripts/smoke-exe.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.135.0",
    "@dagrejs/dagre": "^3.1.2",
    "@hono/node-server": "^2.1.5",
    "@xyflow/react": "^12.12.0",
    "fast-xml-parser": "^5.11.2",
    "hono": "^4.13.13",
    "html-to-image": "1.11.11",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.6",
    "esbuild": "0.28.2",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "postject": "1.0.0-alpha.6",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.0.4",
    "vitest": "^5.0.5"
  }
}
