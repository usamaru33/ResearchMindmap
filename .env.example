# Copy to .env and fill in what you have. Every key is optional.
# Never commit .env: it is in .gitignore. Keys stay on the server and are never sent to the browser.
PORT=8787

# Network access. The API spends your API keys, so by default it only listens on
# this machine and only answers pages served from localhost.
# HOST=0.0.0.0 exposes it to your network: only do that behind your own auth/proxy.
HOST=127.0.0.1
# Extra host names (comma-separated) allowed in the Host header, e.g. a LAN name.
ALLOWED_HOSTS=
# Extra page origins (comma-separated) allowed to call the API, e.g. https://mindmap.example
ALLOWED_ORIGINS=

# OpenAlex: without a key, requests share a small free daily budget per IP.
# Get a free key at https://openalex.org/settings/api
OPENALEX_API_KEY=

# Semantic Scholar: without a key, requests are often rate limited (429).
# https://www.semanticscholar.org/product/api#api-key-form
SEMANTIC_SCHOLAR_API_KEY=

# IEEE Xplore: required to enable the IEEE source. https://developer.ieee.org/
IEEE_API_KEY=

# PubMed E-utilities (raises rate limit). https://www.ncbi.nlm.nih.gov/account/
NCBI_API_KEY=

# Crossref polite pool contact address
CROSSREF_MAILTO=

# DBLP sometimes serves a bot-check page; enable it explicitly
ENABLE_DBLP=false

# Claude (LLM features). Without a key, non-LLM fallbacks are used.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# Response cache
CACHE_DIR=.cache
CACHE_TTL_HOURS=72
